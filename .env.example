# Supabase Session pooler URL (IPv4; the db.<ref>.supabase.co direct host is IPv6-only and usually unreachable).
# Dashboard: Settings -> Database -> Connection string -> Session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# DGX vLLM (OpenAI-compatible). Reachable over Tailscale as `dgx-khan1051` or the 100.x IP.
LLM_BASE_URL=http://100.76.204.90:8000/v1
LLM_MODEL=dgx-current
# vLLM on the DGX is keyless today; set only if the server starts requiring auth.
# LLM_API_KEY=
# LLM_TIMEOUT_SECONDS=180
# LLM_MAX_CONCURRENCY=2
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=4096

# Comma-separated domains allowed to bypass robots.txt (manual review required per domain).
# ROBOTS_ALLOWLIST=example.org,other.org

# Optional overrides
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# DATA_DIR=data
